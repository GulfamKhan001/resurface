# Neon pooled connection string — the one containing "-pooler".
# Free project at https://neon.tech, no local install needed.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Required for extraction (npm run eval, npm run ingest, npm run bot).
# Everything else — the queue, chaos, kill-test — runs without it.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed for `npm run bot`. From @BotFather on Telegram.
# The bot is allowlist-only: add your Telegram user id to the bot_users table
# or it will ignore you, by design.
TELEGRAM_BOT_TOKEN=

# Optional. Ceiling on ONE extraction run, in USD. Defaults to 0.50.
MAX_EXTRACT_USD=0.50

# Optional. Where to send OTLP spans. Unset means tracing is a no-op;
# `npm run trace-test` spins up its own receiver on :4318 regardless.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=resurface
OTEL_EXPORTER_OTLP_HEADERS=
# 0.0–1.0. Defaults to 1 (trace everything) — fine at this volume.
TRACE_SAMPLE_RATE=1

# Optional. Links per hour per bot user. Defaults to 20.
BOT_MAX_LINKS_PER_HOUR=20
